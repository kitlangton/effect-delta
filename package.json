{
  "name": "effect-delta",
  "version": "0.1.0",
  "description": "Schema-derived, compositional patches for Effect",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "bunx effect-language-service patch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "bun run typecheck && bun run test",
    "build": "tsc -p tsconfig.build.json",
    "pack": "bun pm pack --dry-run",
    "release:check": "bun run check && bun run build && bun run pack",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run release:check && changeset publish"
  },
  "peerDependencies": {
    "effect": "^4.0.0-beta.72"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@effect/language-service": "^0.85.1",
    "@effect/vitest": "4.0.0-beta.72",
    "effect": "4.0.0-beta.72",
    "typescript": "^6.0.3",
    "vitest": "4.1.4"
  }
}
